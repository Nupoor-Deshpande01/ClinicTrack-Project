# Copy to client/.env and adjust if your API runs on another origin.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Base URL of the ClinicTrack REST API
VITE_API_URL=http://localhost:5000

# Where the static marketing site (public-site/) is reachable. Used by the
# login screen's "Back to the clinic website" link. Defaults to /site/, which
# the dev server proxies to the API.
VITE_PUBLIC_SITE_URL=/site/
