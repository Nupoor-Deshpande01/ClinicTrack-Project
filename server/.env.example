# Copy this file to .env and fill in real values. NEVER commit the real .env.

# MongoDB connection string (use the repo-local fallback for Phase 2; use
# MongoDB Atlas in production - mongodb+srv://user:pass@cluster/clinictrack)
MONGO_URI=mongodb://127.0.0.1:27017/clinictrack

# JWT signing secret: generate a long random string, e.g. in a terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Port the Express API listens on
PORT=5000

# Origin of the React client: CORS allow-list and the base of the QR
# verification links printed on prescription PDFs (/verify/:qrToken).
CLIENT_URL=http://localhost:5173
